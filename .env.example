# Yandex Market Partner API key (from your cabinet settings)
YANDEX_API_KEY=your_api_key_here

# Your business (cabinet) ID — get it from GET /v2/campaigns response
YANDEX_BUSINESS_ID=your_business_id_here

# Promo code to send in the reply message
PROMO_CODE=XXXXXXX

# Your storefront URL on Yandex Market
STOREFRONT_URL=https://market.yandex.ru/shop--your-shop-name

# Port (Railway sets this automatically)
PORT=3000
